#!/bin/sh
# This header finds the directory of THIS script, then runs it using its local .venv
""":"
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
exec "$SCRIPT_DIR/.venv/bin/python3" "$0" "$@"
"""

import argparse
import sys
import time
import yt_dlp

def progress_hook(d):
    """Custom progress display for VODs and non-live videos."""
    if d['status'] == 'downloading':
        # Extract total bytes or estimated total bytes if total isn't immediately known
        total = d.get('total_bytes') or d.get('total_bytes_estimate') or 0
        downloaded = d.get('downloaded_bytes', 0)
        
        if total > 0:
            percent = (downloaded / total) * 100
            speed = d.get('speed', 0)
            # Format speed to MB/s safely
            speed_mb = speed / (1024 * 1024) if speed else 0
            
            # Print an updating progress line in place (\r)
            sys.stdout.write(f"\r[Downloading] Progress: {percent:.1f}% | Speed: {speed_mb:.2f} MB/s")
            sys.stdout.flush()
    elif d['status'] == 'finished':
        print("\n[Processing] Finishing up file merging/conversion...")

def main():
    # 1. Command line flags
    parser = argparse.ArgumentParser(description="CLI Downloader for YouTube and Twitch.")
    parser.add_argument("url", help="The YouTube or Twitch URL to download")
    
    quality_group = parser.add_mutually_exclusive_group()
    quality_group.add_argument("--best", action="store_true", help="Download highest quality available")
    quality_group.add_argument("--1080p", dest="full_hd", action="store_true", help="Cap video at 1080p")
    quality_group.add_argument("--720p", dest="low_res", action="store_true", help="Cap video at 720p")
    quality_group.add_argument("--audio", action="store_true", help="Extract audio only as MP3")

    args = parser.parse_args()

    # 2. Dynamic naming using exact start second to separate split streams safely
    output_template = '[%(current_timestamp>%Y-%m-%d_%H-%M-%S)s] [%(uploader)s] - %(title)s.%(ext)s'

    ydl_opts = {
        'outtmpl': output_template,
        'hls_use_mpegts': True,        # Safe recording container for live splits
        'noplaylist': True,
        'progress_hooks': [progress_hook], # Connects our custom percentage counter
        'logger': None,                # Keeps output clean for our custom hook
    }

    # 3. Apply format selections based on flags
    if args.full_hd:
        ydl_opts['format'] = 'bestvideo[height<=1080]+bestaudio/best[height<=1080]'
    elif args.low_res:
        ydl_opts['format'] = 'bestvideo[height<=720]+bestaudio/best[height<=720]'
    elif args.audio:
        ydl_opts['format'] = 'bestaudio/best'
        ydl_opts['postprocessors'] = [{
            'key': 'FFmpegExtractAudio',
            'preferredcodec': 'mp3',
            'preferredquality': '192',
        }]
    else:
        ydl_opts['format'] = 'bestvideo+bestaudio/best'

    print(f"Target URL: {args.url}")
    
    # 4. Infinite automatic retry loop for handling live stream disconnections
    retry_delay = 10  # Seconds to wait before reconnecting
    
    while True:
        try:
            print("\n[Connecting] Establishing stream connection...")
            with yt_dlp.YoutubeDL(ydl_opts) as ydl:
                ydl.download([args.url])
            
            # If it finishes cleanly without an exception, break the loop
            print("\n[Done] Download completed successfully!")
            break
            
        except KeyboardInterrupt:
            # Allows you to clean stop the recording manually with Ctrl+C
            print("\n[Stopped] Download cancelled by user.")
            break
            
        except Exception as e:
            # Handles dropped connections, network timeouts, or stream hangups
            print(f"\n[Warning] Connection dropped or streamer went offline: {e}")
            print(f"[Retry] Re-attempting download in {retry_delay} seconds... (Ctrl+C to give up)")
            time.sleep(retry_delay)

if __name__ == "__main__":
    main()
