#!/bin/sh
# This header finds the directory of THIS script, then runs it using its local .venv
""":"
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
exec "$SCRIPT_DIR/.venv/bin/python3" "$0" "$@"
"""

import argparse
import sys
import os
import subprocess
import time
import yt_dlp

# Tracks if the video finished downloading 100% cleanly
is_finished = False

class SilentLogger:
    """Passes inner network exceptions straight to Python without terminal spam."""
    def debug(self, msg): pass
    def warning(self, msg): pass
    def error(self, msg):
        raise Exception(msg)

def progress_hook(d):
    global is_finished
    if d['status'] == 'downloading':
        total = d.get('total_bytes') or d.get('total_bytes_estimate') or 0
        downloaded = d.get('downloaded_bytes', 0)
        
        if total > 0:
            percent = (downloaded / total) * 100
            speed = d.get('speed', 0)
            speed_mb = speed / (1024 * 1024) if speed else 0
            
            eta = d.get('eta')
            eta_str = f"{int(eta) // 60}m {int(eta) % 60}s" if eta is not None else "Unknown"
            
            sys.stdout.write(f"\r[Downloading] {percent:.1f}% | Speed: {speed_mb:.2f} MB/s | ETA: {eta_str}\x1b[K")
            sys.stdout.flush()
            
    elif d['status'] == 'finished':
        is_finished = True
        sys.stdout.write("\n[Processing] Finalizing file components...\n")
        sys.stdout.flush()

def rescue_file(filename, audio_only=False):
    """Stitches available fragments together into a marked partial file if aborted."""
    part_file = filename + ".part"
    base_name, _ = os.path.splitext(filename)
    
    # Locate active fragment tracking assets in the directory path
    if not os.path.exists(part_file):
        for item in os.listdir('.'):
            if item.startswith(os.path.basename(filename)) and item.endswith('.part'):
                part_file = item
                break

    if os.path.exists(part_file):
        print(f"\n[Rescue] Found incomplete data: {part_file}")
        
        # Determine the correct extension
        ext = ".mp3" if audio_only else ".mp4"
        output_file = f"{base_name}.part{ext}"
            
        if audio_only:
            print(f"[Rescue] Finalizing partial data to Audio (Overwriting existing): {output_file}")
            cmd = ['ffmpeg', '-y', '-i', part_file, '-vn', '-c:a', 'libmp3lame', '-q:a', '2', output_file]
        else:
            print(f"[Rescue] Finalizing partial data to Video (Overwriting existing): {output_file}")
            cmd = ['ffmpeg', '-y', '-i', part_file, '-c', 'copy', output_file]
            
        try:
            subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
            print(f"[Rescue] Success! Partial clip saved as: {output_file}")
            os.remove(part_file)
        except Exception as error:
            print(f"[Rescue Error] ffmpeg failed: {error}")
    else:
        print("\n[Rescue] No part file found to salvage.")

def main():
    global is_finished
    parser = argparse.ArgumentParser(description="CLI Downloader for YouTube and Twitch.")
    parser.add_argument("url", help="The YouTube or Twitch URL to download")
    
    quality = parser.add_mutually_exclusive_group()
    quality.add_argument("--best", action="store_true")
    quality.add_argument("--1080p", dest="hd", action="store_true")
    quality.add_argument("--720p", dest="sd", action="store_true")
    quality.add_argument("--audio", action="store_true")

    args = parser.parse_args()

    # Clean output template layout with no brackets []
    output_template = '%(timestamp>%Y-%m-%d_%H-%M-%S)s %(uploader)s - %(title)s.%(ext)s'

    ydl_opts = {
        'outtmpl': output_template,
        'noplaylist': True,
        'hls_use_mpegts': True, 
        'progress_hooks': [progress_hook],
        'logger': SilentLogger(),     
        'no_warnings': True,
        'nooverwrites': True,
        'overwrites': False,
        'retries': 0,                 
        'fragment_retries': 0,        
        'skip_unavailable_fragments': False,
    }

    if args.hd:
        ydl_opts['format'] = 'bestvideo[height<=1080]+bestaudio/best[height<=1080]'
    elif args.sd:
        ydl_opts['format'] = 'bestvideo[height<=720]+bestaudio/best[height<=720]'
    elif args.audio:
        ydl_opts['format'] = 'bestaudio/best'
        ydl_opts['postprocessors'] = [{'key': 'FFmpegExtractAudio', 'preferredcodec': 'mp3', 'preferredquality': '192'}]
    else:
        ydl_opts['format'] = 'bestvideo+bestaudio/best'

    print(f"Target URL: {args.url}")
    
    while True:
        try:
            is_finished = False
            print("[Connecting] Fetching original broadcast details...")
            
            with yt_dlp.YoutubeDL(ydl_opts) as ydl:
                metadata = ydl.extract_info(args.url, download=False)
                
                raw_filename = ydl.prepare_filename(metadata)
                base_name, _ = os.path.splitext(raw_filename)
                target_ext = ".mp3" if args.audio else ".mp4"
                filename = base_name + target_ext
                
                print(f"[File Target] Destination: {filename}")
                
                # Check if a 100% complete full file already exists in the folder
                if os.path.exists(filename):
                    print("[System] Complete file already exists in directory. Skipping.")
                    is_finished = True
                    break
                
                ydl.download([args.url])
                
            if not is_finished:
                raise Exception("Network stream disconnected prematurely.")
                
            print("[Done] Download completed successfully!")
            break 
            
        except KeyboardInterrupt:
            print("\n[Stopped] Download cancelled by user.")
            break
            
        except Exception as error:
            print(f"\n[Warning] Connection failure: {error}")
            
            try:
                ask_retry = input("Network offline. Retry connection? [Y/n]: ").strip().lower()
            except KeyboardInterrupt:
                ask_retry = 'n'
            
            if ask_retry in ['y', 'yes', '']:
                print("[Reset] Re-attempting connection layout...")
                time.sleep(1)
                continue
            else:
                try:
                    ask_save = input("Save what has been downloaded so far? [Y/n]: ").strip().lower()
                except KeyboardInterrupt:
                    ask_save = 'n'
                    
                if ask_save in ['y', 'yes', '']:
                    print("[Aborting] finalising partial file rescue...")
                    if filename:
                        rescue_file(filename, audio_only=args.audio)
                break

if __name__ == "__main__":
    main()
